# ScholarEdge Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_NAME=ScholarEdge
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_URL=sqlite+aiosqlite:///./data/scholaredge.db

# Processing Settings
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_CHARS=600
CHUNK_OVERLAP_CHARS=100

# AI Provider Settings (MVP defaults to local / dev providers)
LLM_PROVIDER=development
VISION_PROVIDER=development

# Embeddings. Leave EMBEDDING_PROVIDER unset to auto-select the best available local backends:
# the real all-MiniLM-L6-v2 model when it is downloaded, otherwise the deterministic
# sha256 feature-hash fallback (which /api/health reports as embedding_degraded, because it
# costs real retrieval quality: 44.4% vs 94.4% answer correctness on the book benchmark).
# Set it explicitly to pin one: "onnx_minilm" | "development" | "qualcomm".
#   python scripts/download_embedding_model.py   # real all-MiniLM-L6-v2 ONNX, sha256-verified
#   EMBEDDING_PROVIDER=development              # force the deterministic fallback (e.g. CI)
#   python scripts/reindex_embeddings.py        # required after switching providers on an existing index
# EMBEDDING_PROVIDER=onnx_minilm

# BM25 fusion. Leave unset to follow the resolved embedding provider, which is the measured
# best default: with semantic embeddings fusion costs a retrieval hit (94.4% -> 83.3% answer
# correctness on the book benchmark) and with the hash fallback it is the main gain
# (44.4% -> 72.2%). Force it either way when a corpus disagrees.
# HYBRID_RETRIEVAL=false

# Optional external generation provider. External cloud providers are strictly opt-in.
# Configure API keys only in your local .env file (NEVER commit actual keys).
ALLOW_EXTERNAL_PROVIDERS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
# Verified working model for RAG research workflows:
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# Fallback lighter model (faster, lower cost): qwen/qwen-2.5-7b-instruct
OPENROUTER_MAX_TOKENS=1024


