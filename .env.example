# ScholarEdge Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_NAME=ScholarEdge
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_URL=sqlite+aiosqlite:///./data/scholaredge.db

# Processing Settings
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_CHARS=600
CHUNK_OVERLAP_CHARS=100

# AI Provider Settings (MVP defaults to local / mock / dev providers)
LLM_PROVIDER=development
EMBEDDING_PROVIDER=development
VISION_PROVIDER=development

# Optional external generation provider. External cloud providers are strictly opt-in.
# To enable Gemini, set ALLOW_EXTERNAL_PROVIDERS=true and configure GEMINI_API_KEY.
ALLOW_EXTERNAL_PROVIDERS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
